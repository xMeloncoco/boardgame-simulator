  "variables": {
    "money": {
      "initial": 10,
      "type": "number"
    },
    "round": {
      "initial": 1,
      "type": "number"
    },
    "maxRounds": {
      "initial": 7,
      "type": "number"
    },
    "tokensPerDraw": {
      "initial": 5,
      "type": "number"
    }
  },
  "phases": [
    {
      "id": "setup",
      "name": "Setup",
      "description": "Set up the game for January market",
      "nextPhase": "at-sea"
    },
    {
      "id": "at-sea",
      "name": "At Sea",
      "description": "Draw tokens from the sea bag and place on boats",
      "nextPhase": "on-land"
    },
    {
      "id": "on-land",
      "name": "On Land",
      "description": "Sell fish to market, buy boats and upgrades",
      "nextPhase": "end-of-day"
    },
    {
      "id": "end-of-day",
      "name": "End of Day",
      "description": "Pay upkeep, fish spawn, advance round",
      "nextPhase": "at-sea"
    },
    {
      "id": "game-over",
      "name": "Game Over",
      "description": "Check win/lose conditions"
    }
  ],
  "setup": [
    {
      "action": "loadSeaBag",
      "parameters": {
        "sardines": 5,
        "scallops": 5,
        "water": 10
      }
    },
    {
      "action": "dealBoatMarket",
      "parameters": {
        "count": 3
      }
    },
    {
      "action": "dealUpgradeMarket",
      "parameters": {
        "count": 3
      }
    },
    {
      "action": "giveStartingBoat",
      "parameters": {
        "boat": "boat-el-dorado"
      }
    }
  ],
  "winConditions": [
    {
      "description": "Have €40 and at least 4 sardines and 4 scallops in the sea",
      "check": "checkWinCondition"
    }
  ],
  "loseConditions": [
    {
      "description": "Run out of water tokens (overfished)",
      "check": "checkOverfished"
    },
    {
      "description": "Complete all rounds without meeting win condition",
      "check": "checkRoundsExceeded"
    }
  ]
}
